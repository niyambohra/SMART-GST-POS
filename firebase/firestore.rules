rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'cashier';
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    function isManager() {
      return isAuthenticated() && (request.auth.token.role == 'manager' || isAdmin());
    }

    function isStaff() {
      return isAuthenticated() && (request.auth.token.role in ['admin', 'manager', 'cashier']);
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public read for POS catalog lookup
      allow create, update: if isManager(); // Admin & Manager can add / edit products and update stock
      allow delete: if isAdmin(); // Only Admin can permanently delete products
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Customer Ledger Collection
    match /ledger/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin(); // Immutable audit ledger
    }

    // Sales Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isManager(); // Cancelling invoice requires Manager or Admin
      allow delete: if isAdmin();
    }

    // Settings Collection (Store Identity, GST Config, Payment settings)
    match /settings/{docId} {
      allow read: if true; // POS register needs store details and tax slabs
      allow write: if isAdmin(); // Only Admin can modify GST rates, profile, or payment settings
    }

    // Staff & User Access Control
    match /staff/{staffId} {
      allow read, write: if isAdmin(); // Only Admin can manage staff profiles and roles
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin(); // Only Admin can review immutable audit trail
      allow create: if isStaff(); // Any authenticated staff action can append audit log
      allow update, delete: if false; // Audit logs can NEVER be updated or deleted
    }
  }
}
